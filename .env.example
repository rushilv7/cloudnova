# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- Azure AI Foundry model deployment (required for --ask, --demo and live evals)
# Resource endpoint, for example https://<resource>.openai.azure.com/
# An endpoint ending in /openai/v1/ is also accepted; API version is then not needed.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# The deployment name you chose in Foundry (not the base model name).
AZURE_OPENAI_DEPLOYMENT=
# Required for classic resource endpoints, for example 2024-10-21.
AZURE_OPENAI_API_VERSION=

# --- Optional overrides (defaults shown)
# CLOUDNOVA_CSV=data/cloudnova_invoices.csv
# CLOUDNOVA_OUT_DIR=out
# CLOUDNOVA_ROW_CAP=200
# CLOUDNOVA_QUERY_TIMEOUT_S=5
# CLOUDNOVA_LLM_TIMEOUT_S=60
